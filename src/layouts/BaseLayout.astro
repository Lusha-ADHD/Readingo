---
import "../styles/global.css";
import { sitePath } from "../utils/paths";

type Props = {
  title?: string;
  description?: string;
  bodyClass?: string;
  canonicalPath?: string;
  ogType?: "website" | "article";
  socialImagePath?: string;
  socialImageAlt?: string;
};

const {
  title = "Readingo - Apprendre à lire en jouant",
  description = "Des mini-jeux gratuits pour aider les enfants de 5 à 7 ans à apprendre les lettres, les syllabes et les mots.",
  bodyClass = "",
  canonicalPath,
  ogType = "website",
  socialImagePath = "/assets/social/readingo-home.jpg",
  socialImageAlt = "Pana invite à suivre un sentier côtier dans l’univers de Readingo.",
} = Astro.props;

const canonicalUrl = new URL(
  sitePath(canonicalPath ?? Astro.url.pathname),
  Astro.site ?? Astro.url,
).toString();
const socialImageUrl = new URL(
  sitePath(socialImagePath),
  Astro.site ?? Astro.url,
).toString();
const siteUrl = new URL(sitePath("/"), Astro.site ?? Astro.url).toString();
const logoUrl = new URL(
  sitePath("/assets/Readingo_Icon.png"),
  Astro.site ?? Astro.url,
).toString();
const isHomepage = canonicalUrl === siteUrl;
const homepageStructuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}#organization`,
      name: "Readingo",
      url: siteUrl,
      description:
        "Des jeux de lecture gratuits pour aider les enfants de 5 à 7 ans à apprendre les lettres, les syllabes et les mots.",
      logo: {
        "@type": "ImageObject",
        url: logoUrl,
        contentUrl: logoUrl,
        width: 1254,
        height: 1254,
      },
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: "Readingo",
      inLanguage: "fr-FR",
      publisher: {
        "@id": `${siteUrl}#organization`,
      },
    },
  ],
};

---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Readingo" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link
      rel="icon"
      href={sitePath("/favicon.png")}
      type="image/png"
      sizes="192x192"
    />
    <link rel="apple-touch-icon" href={sitePath("/assets/Readingo_Icon.png")} />
    <link
      rel="preload"
      href={sitePath("/assets/fonts/nunito-latin.ttf")}
      as="font"
      type="font/ttf"
      crossorigin="anonymous"
    />
    <style
      is:inline
      set:html={`@font-face{font-family:Nunito;src:url("${sitePath("/assets/fonts/nunito-latin.ttf")}") format("truetype");font-style:normal;font-weight:200 1000;font-display:swap;}`}
    ></style>
    {
      isHomepage && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(homepageStructuredData)}
        />
      )
    }
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <header class="site-header">
      <div class="site-header__inner page-shell">
        <a class="brand" href={sitePath("/")} aria-label="Accueil Readingo">
          <span class="brand__mark" aria-hidden="true">
            <img
              src={sitePath("/assets/Readingo_Icon.png")}
              alt=""
              width="1254"
              height="1254"
            />
          </span>
          <span class="brand__name">Readingo</span>
        </a>
        <nav class="main-nav" aria-label="Navigation principale">
          <a href={sitePath("/#jeux")}>Jeux</a>
          <a class="main-nav__link--secondary" href={sitePath("/#parents")}>Pour les parents</a>
          <a class="main-nav__link--secondary" href={sitePath("/apprendre-a-lire/")}>Conseils</a>
          <a class="main-nav__cta" href={sitePath("/#jeux")}>Jouer</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="site-footer__inner page-shell">
        <div class="site-footer__brand">
          <strong>Readingo</strong>
          <span>Apprendre à lire devient une aventure.</span>
        </div>
        <nav class="site-footer__nav" aria-label="Navigation de pied de page">
          <a href={sitePath("/#jeux")}>Jeux</a>
          <a href={sitePath("/apprendre-a-lire/")}>Conseils pour les parents</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
